# ===== Ánh Ngân AI Video Studio — biến môi trường =====
# Sao chép thành .env và ĐỔI mọi giá trị CHANGE_ME. Không commit .env.

ENVIRONMENT=production
# Chuỗi ngẫu nhiên ≥ 32 ký tự: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# Khoá mã hoá API key nhà cung cấp (Fernet): python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

POSTGRES_USER=anngan
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=anngan_studio
# Dùng khi chạy ngoài Docker:
DATABASE_URL=postgresql+psycopg://anngan:CHANGE_ME_DB_PASSWORD@localhost:5432/anngan_studio
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# Object Storage: local = volume trên máy chủ (mặc định, đã kiểm thử); s3 = S3-compatible (AWS S3, Cloudflare R2, Wasabi...)
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=anngan-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_MB=500

# Web & bảo mật phiên
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false            # true khi chạy HTTPS
ACCESS_TOKEN_EXPIRE_MINUTES=480
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600
HTTP_PORT=8080

# Tài khoản Super Admin khởi tạo. Bỏ trống mật khẩu → hệ thống sinh ngẫu nhiên, in ra 1 lần, bắt buộc đổi.
INITIAL_ADMIN_EMAIL=ceo@anhngan.vn
INITIAL_ADMIN_PASSWORD=
# Mật khẩu chung cho tài khoản DEMO theo vai trò (bỏ trống → sinh ngẫu nhiên). Production: SEED_ARGS=--no-demo-users
DEMO_USER_PASSWORD=
SEED_ARGS=

# Video
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
MOCK_VIDEO_WIDTH=1080
MOCK_VIDEO_HEIGHT=1920

# Máy Windows không Docker (xem docs/deployment/WINDOWS.md):
# FONT_FILE=C:/Windows/Fonts/arial.ttf
# ANNGAN_DATA_DIR=D:/AnhNganStudio
# STORAGE_LOCAL_ROOT=D:/AnhNganStudio/storage
# BACKUP_DIR=D:/AnhNganStudio/backups
# WEB_PORT=3001

# AI (chỉ dùng ở PRODUCTION MODE khi đã nhập key tại M15 → API Connections; biến này chỉ là model mặc định)
ANTHROPIC_MODEL=claude-opus-5-5
USD_VND_RATE=26000
